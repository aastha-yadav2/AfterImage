# AFTERIMAGE — Firebase Hybrid AI Configuration (#BuildHybridAI 2026)
# Duplicate this file to .env and insert your project credentials from the Firebase Console.
# If these variables are not present, AFTERIMAGE will gracefully run in offline fallback mode
# and clearly indicate its status in the Custodian Console.

# Firebase Web App Configuration (Project Settings -> General -> Your apps -> Web app)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase AI Logic Model Choice
# Recommended: gemini-3.8-flash
VITE_FIREBASE_AI_MODEL=gemini-3.8-flash

# Firebase App Check Configuration
# For local Vite development with App Check enforcement active:
# Generate a debug token in Firebase Console -> App Check -> Apps -> Manage debug tokens,
# register it for your web app, and paste the UUID string below.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# For production web deployment (ReCaptcha Enterprise site key):
VITE_FIREBASE_APPCHECK_SITE_KEY=
